{
  "id": "demo-delivery-options",
  "name": "Demo delivery options",
  "match": { "text": [{ "row": 1, "col": 33, "text": "Delivery Options" }] },
  "title": "Delivery Options",
  "changes": [
    { "op": "widget", "field": "7:22", "widget": { "type": "time", "format": "HHMM" } },
    { "op": "hide", "at": { "row": 7, "col": 30 } },
    { "op": "widget", "field": "8:22", "widget": { "type": "mask", "mask": "(999) 999-9999" } },
    { "op": "hide", "at": { "row": 8, "col": 34 } },
    { "op": "widget", "field": "9:22", "widget": { "type": "lookup", "options": [
      { "value": "UPS", "label": "UPS" },
      { "value": "FDX", "label": "FedEx" },
      { "value": "USPS", "label": "US Mail" },
      { "value": "DHL", "label": "DHL" },
      { "value": "LTL", "label": "Freight (LTL)" }
    ], "prompt": { "aid": "F4" } } },
    { "op": "hide", "at": { "row": 9, "col": 30 } },
    { "op": "widget", "field": "10:22", "widget": { "type": "toggle", "on": "Y", "off": "N" } },
    { "op": "hide", "at": { "row": 10, "col": 30 } },
    { "op": "component", "name": "star-rating", "field": "11:22", "at": { "row": 11, "col": 22 }, "width": 12, "height": 1,
      "options": { "max": 5 } },
    { "op": "hide", "at": { "row": 11, "col": 30 } },
    { "op": "label", "at": { "row": 13, "col": 4 }, "text": "Changes reach the carrier within the hour.", "style": "note",
      "help": "Deliver after is the earliest time the carrier comes. The customer is told by text message when Notify customer is on." },
    { "op": "button", "label": "Back to the order", "action": { "aid": "F12" } }
  ]
}
