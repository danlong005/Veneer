# Copy to .env (development) or to the server's config file, e.g.
# /QOpenSys/etc/veneer/veneer.env on IBM i or /etc/veneer/veneer.env on Linux,
# and start the server with --config <file>. .env is git-ignored.
# 5250 (IBM i, the default) or 3270 (mainframe: z/OS, z/VM, VSE). One host type per server.
VENEER_HOST_TYPE=5250
VENEER_HOST=myibmi.example.com
# 23 for plain Telnet, 992 for TLS. See "TLS and HTTPS" in deploy/README.md.
VENEER_PORT=992
VENEER_TLS=true
# The host's certificate must be trusted and name VENEER_HOST. false skips the
# check (still encrypted, but not safe from impersonation): for testing only.
VENEER_TLS_REJECT_UNAUTHORIZED=true
# PEM file of the CA that issued the host's certificate, e.g. the IBM i's local
# CA from DCM. Replaces the built-in list of public CAs.
VENEER_TLS_CA=
# Optional fixed device name, for npm run cli only (e.g. VENEER01); blank lets
# IBM i assign QPADEVxxxx. The server names devices with VENEER_DEVNAME_PREFIX.
VENEER_DEVNAME=
# 5250: IBM-3179-2 (24x80 color) or IBM-3477-FC (27x132 color).
# 3270: IBM-3278-2-E (24x80), -3-E (32x80), -4-E (43x80) or -5-E (27x132).
# Blank picks the 24x80 type for the host type.
VENEER_TERMINAL_TYPE=
# Host code page: 37 (default, US/Canada), 273 (Germany/Austria) or 1047 (z/OS Latin-1)
VENEER_CCSID=
# 3270 only: false to use plain TN3270 even when the host offers TN3270E
VENEER_TN3270E=
# 3270 only: the keys Page Up and Page Down send. Blank = PF7,PF8; or e.g. PF19,PF20; off = none
VENEER_PAGE_KEYS=
# IBM i only: auto signs users on from Veneer's own sign-on page (RFC 4777);
# blank shows the IBM i's sign-on screen. Needs QRMTSIGN *VERIFY or *SAMEPRF.
VENEER_SIGNON=
# With VENEER_SIGNON=auto or the macro API: the IBM i's QPWDLVL system value
# (0, 1, 2 or 3; DSPSYSVAL QPWDLVL), which says how the password must be encrypted.
VENEER_QPWDLVL=
# The macro API (README, "Running macros from other systems"): a JSON file of the
# systems that may run macros, each with its token's hash and IBM i service profile.
# Blank: off. Their passwords go in the variables the file names, e.g.
# VENEER_API_ERP_PASSWORD=
VENEER_API_CLIENTS=

# ---- Session server (npm run dev / npm start) ----
# 127.0.0.1 accepts only browsers on this machine (or SSH tunnels). Use 0.0.0.0 to
# accept other machines. Without VENEER_HTTPS_* below they use http://, and passwords
# cross the network unencrypted: fine for a trial, not for production.
VENEER_LISTEN_HOST=127.0.0.1
VENEER_LISTEN_PORT=8080
# PEM certificate and key; when set the server speaks HTTPS/WSS (browse to https://).
# Optional: blank serves plain HTTP. For local development, mkcert makes a trusted
# localhost certificate (deploy/README.md).
VENEER_HTTPS_CERT=
VENEER_HTTPS_KEY=
VENEER_IDLE_TIMEOUT_MINUTES=30
VENEER_RESUME_GRACE_SECONDS=60
VENEER_MAX_SESSIONS=100
# Name devices PREFIX001, PREFIX002, ... (1-8 chars) instead of QPADEVxxxx.
# On a 3270 host these are LU names (1-6 chars, as LU names are at most 8):
# they must match LUs the host's TN3270 server defines. Blank lets the host pick.
VENEER_DEVNAME_PREFIX=
# Comma-separated browser origins allowed to connect; blank = same origin only
VENEER_ALLOWED_ORIGINS=
# Directory of the built browser client (Milestone 3)
VENEER_STATIC_DIR=
# Directory of screen customization JSON files (default: screens/ in the repo)
VENEER_SCREENS_DIR=
# Directory of custom component modules (name.js), served at /components/
# (default: components/ in the repo). Only people who run the server can add them.
VENEER_COMPONENTS_DIR=
# Where Veneer keeps what it records itself, such as the screen inventory
# (default: data/ in the repo; not customizations, so not for git)
VENEER_DATA_DIR=
# The designer is off unless one of these two is set; see "Getting into the designer"
# in deploy/README.md. Sign on, click Design, change the screen, Save.
# local = browsers on this machine use the designer without a token (npm run dev sets it).
# On an IBM i, that means through an SSH tunnel: ssh -L 8080:127.0.0.1:8080 you@ibmi,
# then http://localhost:8080. Through a reverse proxy, requests are never local.
# Everyone who can sign on to this machine (including over an SSH tunnel) counts as local.
VENEER_DESIGNER=
# Lets everyone else use the designer; at least 12 characters. Anyone with it can change screens.
VENEER_DESIGNER_TOKEN=
# The admin page (/admin): active sessions, ending a session, recent errors.
# local = browsers on this machine use it without a token (npm run dev sets it), as above.
VENEER_ADMIN=
# Lets everyone else use the admin page; at least 12 characters, and not the designer token.
VENEER_ADMIN_TOKEN=
# debug | info | warn | error
VENEER_LOG_LEVEL=info
# Log to a file instead of stdout (needed on IBM i; Linux can use the journal).
# Rotates at VENEER_LOG_MAX_MB, keeping VENEER_LOG_KEEP old files.
VENEER_LOG_FILE=
VENEER_LOG_MAX_MB=10
VENEER_LOG_KEEP=5
# true logs every 5250 record in hex, for diagnosing host behaviour. Records from the
# browser show only their header, cursor and key, never field values (passwords).
VENEER_TRACE=false

# ---- Branding (see README) ----
# Product name, logo file (PNG, SVG, JPEG, WebP or GIF) and accent colors (#rrggbb).
VENEER_BRAND_NAME=
VENEER_BRAND_LOGO=
VENEER_BRAND_ACCENT=
# Optional; dark mode otherwise uses a lighter shade of VENEER_BRAND_ACCENT.
VENEER_BRAND_ACCENT_DARK=
