# Copy to .env (development) or to the server's config file, e.g.
# /QOpenSys/etc/veneer/veneer.env on IBM i or /etc/veneer/veneer.env on Linux,
# and start the server with --config <file>. .env is git-ignored.
VENEER_HOST=myibmi.example.com
# 23 for plain Telnet, 992 for TLS
VENEER_PORT=992
VENEER_TLS=true
# Set to false only for self-signed host certificates during development
VENEER_TLS_REJECT_UNAUTHORIZED=true
# Optional path to a PEM CA bundle for the host certificate
VENEER_TLS_CA=
# Optional fixed device name (e.g. VENEER01); blank lets IBM i assign QPADEVxxxx
VENEER_DEVNAME=
# IBM-3179-2 (24x80 color) or IBM-3477-FC (27x132 color)
VENEER_TERMINAL_TYPE=IBM-3179-2

# ---- Session server (npm run dev / npm start) ----
# Use 0.0.0.0 to accept connections from other machines (set HTTPS first)
VENEER_LISTEN_HOST=127.0.0.1
VENEER_LISTEN_PORT=8080
# PEM files; when set the server speaks HTTPS/WSS
VENEER_HTTPS_CERT=
VENEER_HTTPS_KEY=
VENEER_IDLE_TIMEOUT_MINUTES=30
VENEER_RESUME_GRACE_SECONDS=60
VENEER_MAX_SESSIONS=100
# Name devices PREFIX001, PREFIX002, ... (1-8 chars) instead of QPADEVxxxx
VENEER_DEVNAME_PREFIX=
# Comma-separated browser origins allowed to connect; blank = same origin only
VENEER_ALLOWED_ORIGINS=
# Directory of the built browser client (Milestone 3)
VENEER_STATIC_DIR=
# Directory of screen customization JSON files (default: screens/ in the repo)
VENEER_SCREENS_DIR=
# Enables the visual designer; at least 12 characters. Anyone with it can change screens.
VENEER_DESIGNER_TOKEN=
# debug | info | warn | error
VENEER_LOG_LEVEL=info
# Log to a file instead of stdout (needed on IBM i; Linux can use the journal).
# Rotates at VENEER_LOG_MAX_MB, keeping VENEER_LOG_KEEP old files.
VENEER_LOG_FILE=
VENEER_LOG_MAX_MB=10
VENEER_LOG_KEEP=5
